{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限：只授予 Orbyte 声明的命令和所需的核心能力",
  "windows": ["main"],
  "permissions": [
    "allow-read-clipboard-text",
    "allow-write-clipboard-text",
    "allow-save-clipboard-image",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "allow-resolve-close-request",
    "allow-list-directory",
    "allow-read-file",
    "allow-write-file",
    "allow-create-file",
    "allow-create-directory",
    "allow-rename-path",
    "allow-delete-path",
    "allow-search-files",
    "allow-watch-project-files",
    "allow-set-unsaved-editor-count",
    "dialog:allow-open",
    "allow-list-projects",
    "allow-create-project",
    "allow-update-project",
    "allow-delete-project",
    "allow-list-groups",
    "allow-create-group",
    "allow-update-group",
    "allow-delete-group",
    "allow-reorder-projects",
    "allow-reorder-groups",
    "allow-get-settings",
    "allow-set-setting",
    "allow-set-settings",
    "allow-load-workspace-layout",
    "allow-save-workspace-layout",
    "allow-list-available-shells",
    "allow-create-terminal",
    "allow-start-terminal",
    "allow-remove-terminal",
    "allow-list-terminal-configs",
    "allow-list-running-workspaces",
    "allow-list-terminal-sessions",
    "allow-report-terminal-diagnostic",
    "allow-terminals-have-running-tasks",
    "allow-subscribe-terminal",
    "allow-ack-terminal",
    "allow-write-terminal",
    "allow-set-active-terminal",
    "allow-resize-terminal",
    "allow-stop-terminal",
    "allow-list-launch-presets",
    "allow-export-terminal-output",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "allow-git-available",
    "allow-git-status",
    "allow-git-worktree-list",
    "allow-git-worktree-add"
  ]
}
